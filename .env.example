# Configurazione di Risma. Copia questo file in .env e completa i valori
# vuoti: DB_PASSWORD e JWT_SECRET sono segreti e non vanno mai nel repository.
# Il file .env serve sia allo sviluppo (make run carica ../.env) sia a
# docker compose, che in Docker sovrascrive gli indirizzi dei servizi
# (database, SMTP, APP_BASE_URL) con quelli della rete interna.

# Porta HTTP del backend
HTTP_PORT=8080

# Database PostgreSQL (in sviluppo il container "db" su localhost)
DB_USER=risma
DB_PASSWORD=
DB_NAME=risma
DB_HOST=localhost
DB_PORT=5432
# Obbligatoria, senza valore predefinito: "disable" solo in locale
DB_SSLMODE=disable

# Segreto per firmare i JWT: almeno 32 byte casuali, es. openssl rand -base64 48
JWT_SECRET=

# IP o reti CIDR dei reverse proxy da cui accettare X-Real-IP, separati da
# virgola; vuoto = nessuno (in sviluppo). In Docker lo imposta il compose.
TRUSTED_PROXIES=

# Indirizzo pubblico del frontend, usato nei link delle email
# (in sviluppo il server di Next.js; in Docker https://localhost)
APP_BASE_URL=http://localhost:3000

# Server SMTP (in sviluppo Mailpit, senza autenticazione)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Risma <noreply@risma.local>
